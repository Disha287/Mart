{
  "name": "campusmart-root",
  "version": "1.0.0",
  "description": "CampusMart - Student Marketplace",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "start:backend": "npm --prefix Backend start",
    "start:frontend": "npm --prefix FrontEnd run dev",
    "backend": "npm --prefix Backend run dev",
    "frontend": "npm --prefix FrontEnd run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
