# ============================================================
# CAMPUSMART BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_strong_random_secret

# Gmail SMTP Configuration
# NOTE: Use a 16-character Google App Password (NOT your normal Gmail password).
# Steps to generate:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an app named "CampusMart" and paste the 16-character code into SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=campusmart044@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM_EMAIL=campusmart044@gmail.com
SMTP_FROM_NAME=CampusMart
SMTP_MOCK=false

# OTP Security & Verification Controls
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Frontend Application URL (for email links)
APP_URL=http://localhost:5173

# Optional: Restrict student registration to specific domain allowlist (comma-separated)
# e.g. chitkara.edu.in,mycampus.ac.in (leave empty to use default educational TLD patterns)
EDUCATIONAL_EMAIL_DOMAINS=
