# ============================================================
# CAMPUSMART BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusmart?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# SMTP Email Configuration (Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Campus Mart" <your_email@gmail.com>

# Development / Mock Mode (set true to test without sending real emails)
SMTP_MOCK=false
