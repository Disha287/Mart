# ============================================================
# CAMPUSMART — .gitignore
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Production & Build outputs (Vite / Frontend)
dist/
**/dist/
build/
.vite/
**/.vite/

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data & temporary files
tmp/
temp/
*.tmp
*.zip

# Operating System files (Windows / macOS / Linux)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Python virtual environments & bytecode (if used)
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Agent workspace artifacts
.agents/
skills-lock.json

# Local root convenience files (kept ignored so GitHub maintains strictly the 4 items: Backend, FrontEnd, .gitignore, README.md)
/package.json
/package-lock.json
/vite.config.mjs

